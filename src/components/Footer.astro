---
import LogoWhite from "../assets/icones/logo_white.webp";
import IconInstagram from "../assets/icones/instagram_footer.webp";
import LogoGba from "../assets/icones/logo_gba.webp";
import LogoUmlp from "../assets/icones/logo_umlp.webp";
import LogoMmi from "../assets/icones/logo_mmi.webp";
import LogoPma from "../assets/icones/logo_pma.webp";

const footerPath = "M1159.5 0c106 0 99.06 110.285 204.5 92.53 145.5-24.5 144.72 54.97 190 56.47s114.82-12.021 185.5-25.092c73-13.5 152.5 38.592 221 38.592 17.03 0 23.04 30.366 22.47 76H0V123.908S21 0 145.5 0s122.494 111.097 232 108.5c61.754-1.464 180.589-56.14 252.5-52 199.429 11.48 143.042 74 263 74 54.477 0 90.242 4.548 133.5-37.97C1052.58 66.898 1078 0 1159.5 0z";
---
<!-- Vague desktop -->
<div class="hidden md:block w-full -mb-22 overflow-x-hidden">
  <svg
    class="block w-full h-auto"
    viewBox="0 -20 1983 259"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d={footerPath} fill="#111" />
  </svg>
</div>

<!-- Vague mobile -->
<div class="block md:hidden w-full -mb-16 overflow-x-hidden">
  <svg width="393" height="198" viewBox="0 0 393 198" preserveAspectRatio="none" class="block w-full h-auto" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M227.041 0c26.495 0 42.69 23.706 40.089 38.31-4.147 23.282-23.838 40.53-8.755 63.075 13.593 20.319 49.995 34.5 83.402 25.61 23.943-6.371 38.536-18.81 51.223-31.153V198H0V38.64c100.906 5.88 91.277 88.355 139.491 88.355 37.094 0 46.54-17.035 52.07-22.435 21.887-21.378-3.918-46.777-5.531-66.25C184.419 18.838 200.868 0 227.041 0z" fill="#111"/>
  </svg>
</div>

<footer class="bg-primary pt-20 md:pt-8 lg:pt-10 pb-20 px-12">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
        
        <!-- Contenu principal du footer -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 py-12 md:items-center md:justify-center ">
            
            <!-- Colonne 1 : Logo -->
            <div class="flex flex-col items-center md:items-start">
                <a href="/" class="mb-6">
                    <div class="text-white">
                        <img class="h-16 md:h-20 w-auto " src={LogoWhite.src} alt="Logo MMI" />
                    </div> 
                </a>
                <p class="text-secondary text-sm text-center md:text-left opacity-70">
                    Exposition Artistiques des créations des étudiants MMI Montbéliard
                </p>
            </div>

            <!-- Colonne 2 : Navigation légale -->
            <div class="flex flex-col items-center justify-center">
                <h3 class="text-secondary mb-8 text-sm">Informations</h3>
                <nav class="flex flex-col gap-4 text-center">
                    <a href="/exposition" class="text-secondary text-sm lg:text-lg hover:opacity-70 transition-opacity">
                        L'exposition
                    </a>
                    <a href="/galerie" class="text-secondary text-sm lg:text-lg hover:opacity-70 transition-opacity">
                        Galerie
                    </a>
                    <a href="/visite-virtuelle" class="text-secondary text-sm lg:text-lg hover:opacity-70 transition-opacity">
                        Visite 360°
                    </a>
                    <a href="/contact" class="text-secondary text-sm lg:text-lg hover:opacity-70 transition-opacity">
                        Nous contacter
                    </a>
                </nav>
            </div>

            <!-- Colonne 3 : Réseaux sociaux & Partenaires -->
            <div class="flex flex-col items-center md:items-end gap-6">
                <!-- Instagram -->
                <div class="flex flex-col items-center md:items-end">
                    <h3 class="text-secondary mb-3 text-sm">Suivez-nous</h3>
                    <a 
                        href="https://www.instagram.com/expommi2026/" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="hover:opacity-70 transition-opacity"
                        aria-label="Suivez-nous sur Instagram"
                    >
                        <img src={IconInstagram.src} alt="" class="h-8 w-8 md:h-12 md:w-12 brightness-0 invert" />
                    </a>
                </div>

                <!-- Partenaires -->
                <div class="flex flex-col items-center md:items-end">
                    <h3 class="text-secondary mb-6 text-sm">Nos partenaires</h3>
                    <div class="flex flex-col items-center md:items-end justify-center gap-4">
                        <div class="flex items-center justify-center gap-4">   
                            <a href="https://www.agglo-montbeliard.fr/" target="_blank" rel="noopener noreferrer" class="shrink-0">
                                <img src={LogoPma.src} alt="MMI Art 26" class="h-8 w-auto object-contain" />
                            </a>
                            
                            <a href="https://www.umlp.fr/" target="_blank" rel="noopener noreferrer" class="shrink-0">
                                <img src={LogoUmlp.src} alt="Université de Montbéliard" class="h-8 w-auto object-contain" />
                            </a>
                        </div>
                        <div class="flex items-center justify-center gap-4">
                            <a href="https://www.geant-beaux-arts.fr/" target="_blank" rel="noopener noreferrer" class="shrink-0">
                                <img src={LogoGba.src} alt="Grand Belfort Agglomération" class="h-16 w-auto object-contain" />
                            </a>
                            <a href="https://www.iut-nfc.univ-fcomte.fr/b-u-t-metiers-du-multimedia-et-de-linternet/" target="_blank" rel="noopener noreferrer" class="shrink-0">
                                <img src={LogoMmi.src} alt="MMI Montbéliard" class="h-16 w-auto object-contain" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Séparateur -->
        <div class="border-t border-secondary/60 my-6"></div>

        <!-- Copyright & Liens légaux -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
            <p class="text-secondary text-xs opacity-80 text-center md:text-left">
                © 2026 MMI ART 26
            </p>
            <a href="/mentions-legales" class="text-secondary text-xs opacity-80 hover:opacity-100 transition-opacity text-center">
                Mentions légales
            </a>
            <a href="#" class="text-secondary text-xs opacity-80 hover:opacity-100 transition-opacity text-center md:text-right">
                Politique de confidentialité
            </a>
        </div>
    </div>
</footer>

