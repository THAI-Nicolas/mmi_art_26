---
import LogoWhite from "../assets/icones/logo_white.webp";
import IconInstagram from "../assets/icones/instagram_footer.webp";
import LogoGba from "../assets/icones/logo_gba.webp";
import LogoUmlp from "../assets/icones/logo_umlp.webp";
import LogoMmi from "../assets/icones/logo_mmi.webp";
import LogoPma from "../assets/icones/logo_pma.webp";

const footerPathDesktop = "M1159.5 0c106 0 99.06 110.285 204.5 92.53 145.5-24.5 144.72 54.97 190 56.47s114.82-12.021 185.5-25.092c73-13.5 152.5 38.592 221 38.592 17.03 0 23.04 30.366 22.47 76H0V123.908S21 0 145.5 0s122.494 111.097 232 108.5c61.754-1.464 180.589-56.14 252.5-52 199.429 11.48 143.042 74 263 74 54.477 0 90.242 4.548 133.5-37.97C1052.58 66.898 1078 0 1159.5 0z";
const footerPathMobile = "M1159.5 0c106 0 99.06 110.285 204.5 92.53 145.5-24.5 144.72 54.97 190 56.47s114.82-12.021 185.5-25.092c73-13.5 152.5 38.592 221 38.592 17.03 0 23.04 30.366 22.47 76H0V123.908S21 0 145.5 0s122.494 111.097 232 108.5c61.754-1.464 180.589-56.14 252.5-52 199.429 11.48 143.042 74 263 74 54.477 0 90.242 4.548 133.5-37.97C1052.58 66.898 1078 0 1159.5 0z";
const footerViewBox = "0 -20 1983 259";
const uniqueIdFooter = `footer-wave-${Math.random().toString(36).substr(2, 9)}`;
---
<div 
  class="footer-wave-container w-full md:-mb-22 -mb-32 overflow-x-hidden relative"
  data-wave-id={uniqueIdFooter}
  data-path={footerPathDesktop}
  data-deform="0.3"
>
  <svg
    class="block w-full h-auto"
    viewBox={footerViewBox}
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      id={`footer-wave-path-${uniqueIdFooter}`}
      d={footerPathDesktop}
      fill="#111"
    />
  </svg>
</div>

<footer class="bg-primary pt-20 md:pt-8 lg:pt-10 pb-20 px-12">
    <div class="max-w-7xl mx-auto px-6 md:px-12">
        
        <!-- Contenu principal du footer -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 py-12 md:items-center md:justify-center ">
            
            <!-- Colonne 1 : Logo -->
            <div class="flex flex-col items-center md:items-start">
                <a href="/" class="mb-6">
                    <div class="text-white">
                        <img class="h-16 md:h-20 w-auto " src={LogoWhite.src} alt="Logo MMI" />
                    </div> 
                </a>
                <p class="text-secondary text-sm text-center md:text-left opacity-70">
                    Exposition Artistiques des créations des étudiants MMI Montbéliard
                </p>
            </div>

            <!-- Colonne 2 : Navigation légale -->
            <div class="flex flex-col items-center justify-center">
                <h3 class="text-secondary mb-8 text-sm">Informations</h3>
                <nav class="flex flex-col gap-4 text-center">
                    <a href="/exposition" class="text-secondary text-sm lg:text-lg hover:opacity-70 transition-opacity">
                        L'exposition
                    </a>
                    <a href="/artistes" class="text-secondary text-sm lg:text-lg hover:opacity-70 transition-opacity">
                        Les artistes
                    </a>
                    <a href="/contact" class="text-secondary text-sm lg:text-lg hover:opacity-70 transition-opacity">
                        Nous contacter
                    </a><a href="/oeuvres" class="text-secondary text-sm lg:text-lg hover:opacity-70 transition-opacity">
                        Les oeuvres
                    </a>
                </nav>
            </div>

            <!-- Colonne 3 : Réseaux sociaux & Partenaires -->
            <div class="flex flex-col items-center md:items-end gap-6">
                <!-- Instagram -->
                <div class="flex flex-col items-center md:items-end">
                    <h3 class="text-secondary mb-3 text-sm">Suivez-nous</h3>
                    <a 
                        href="https://www.instagram.com/expommi2026/" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="hover:opacity-70 transition-opacity"
                        aria-label="Suivez-nous sur Instagram"
                    >
                        <img src={IconInstagram.src} alt="" class="h-8 w-8 md:h-12 md:w-12 brightness-0 invert" />
                    </a>
                </div>

                <!-- Partenaires -->
                <div class="flex flex-col items-center md:items-end">
                    <h3 class="text-secondary mb-6 text-sm">Nos partenaires</h3>
                    <div class="flex flex-col items-center md:items-end justify-center gap-4">
                        <div class="flex items-center justify-center gap-4">   
                            <a href="https://www.agglo-montbeliard.fr/" target="_blank" rel="noopener noreferrer" class="shrink-0">
                                <img src={LogoPma.src} alt="MMI Art 26" class="h-8 w-auto object-contain" />
                            </a>
                            
                            <a href="https://www.umlp.fr/" target="_blank" rel="noopener noreferrer" class="shrink-0">
                                <img src={LogoUmlp.src} alt="Université de Montbéliard" class="h-8 w-auto object-contain" />
                            </a>
                        </div>
                        <div class="flex items-center justify-center gap-4">
                            <a href="https://www.geant-beaux-arts.fr/" target="_blank" rel="noopener noreferrer" class="shrink-0">
                                <img src={LogoGba.src} alt="Grand Belfort Agglomération" class="h-16 w-auto object-contain" />
                            </a>
                            <a href="https://www.iut-nfc.univ-fcomte.fr/b-u-t-metiers-du-multimedia-et-de-linternet/" target="_blank" rel="noopener noreferrer" class="shrink-0">
                                <img src={LogoMmi.src} alt="MMI Montbéliard" class="h-16 w-auto object-contain" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Séparateur -->
        <div class="border-t border-secondary/60 my-6"></div>

        <!-- Copyright & Liens légaux -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
            <p class="text-secondary text-xs opacity-80 text-center md:text-left">
                © 2026 MMI ART 26
            </p>
            <a href="/mentions-legales" class="text-secondary text-xs opacity-80 hover:opacity-100 transition-opacity text-center">
                Mentions légales
            </a>
            <a href="#" class="text-secondary text-xs opacity-80 hover:opacity-100 transition-opacity text-center md:text-right">
                Politique de confidentialité
            </a>
        </div>
    </div>
</footer>

<script>
  document.addEventListener("astro:page-load", () => {
    initFooterWave();
  });

  function initFooterWave() {
    const containers = document.querySelectorAll(".footer-wave-container");

    containers.forEach((container) => {
      const waveId = container.getAttribute("data-wave-id");
      const svg = container.querySelector("svg") as SVGSVGElement;
      const wavePath = svg?.querySelector(`#footer-wave-path-${waveId}`) as SVGPathElement;
      const originalPath = container.getAttribute("data-path");
      const deformStrength = parseFloat(container.getAttribute("data-deform") || "0.3");

      if (!svg || !wavePath || !originalPath) return;

      const points = parseSVGPath(originalPath);

      const viewBoxParts = svg.getAttribute("viewBox")?.split(" ").map(Number) || [0, 0, 1983, 259];
      const vbX = viewBoxParts[0];
      const vbY = viewBoxParts[1];
      const viewBoxWidth = viewBoxParts[2];
      const viewBoxHeight = viewBoxParts[3];

      // Limites de clamping
      const clampMinX = vbX + 2;
      const clampMinY = vbY + 2;
      const clampMaxX = vbX + viewBoxWidth - 2;
      const clampMaxY = vbY + viewBoxHeight - 2;

      const amplitude = 1;
      const safeZoneThreshold = 30;

      let rawMouseX = 0;
      let rawMouseY = 0;
      let smoothMouseX = 0;
      let smoothMouseY = 0;
      let hoverTarget = 0;
      let hoverInfluence = 0;
      let time = 0;

      const mouseLerp = 0.08;
      const hoverInLerp = 0.06;
      const hoverOutLerp = 0.03;

      function animate() {
        time += 0.02;

        smoothMouseX += (rawMouseX - smoothMouseX) * mouseLerp;
        smoothMouseY += (rawMouseY - smoothMouseY) * mouseLerp;

        const lerpFactor = hoverTarget > hoverInfluence ? hoverInLerp : hoverOutLerp;
        hoverInfluence += (hoverTarget - hoverInfluence) * lerpFactor;
        if (hoverInfluence < 0.001) hoverInfluence = 0;

        const deformedPoints = points.map((point, index) => {
          let newX = point.x;
          let newY = point.y;

          // Facteur de fondu progressif (0 aux bords, 1 au centre) — évite les cassures
          const fadeLeft = Math.min(point.x / 250, 1);
          const fadeRight = Math.min((1983 - point.x) / 250, 1);
          const fadeBottom = point.y > 120 ? Math.max(0, 1 - (point.y - 120) / 80) : 1;
          const fadeFactor = Math.min(fadeLeft, fadeRight, fadeBottom);

          if (fadeFactor > 0.01) {
            const wavePhase = time + index * 0.3;
            const offsetX = Math.sin(wavePhase) * amplitude * fadeFactor;
            const offsetY = Math.cos(wavePhase * 0.7) * amplitude * 0.3 * fadeFactor;
            newX = point.x + offsetX;
            newY = point.y + offsetY;
          }

          if (hoverInfluence > 0 && fadeFactor > 0.01) {
            const dx = smoothMouseX - newX;
            const dy = smoothMouseY - newY;
            const distance = Math.sqrt(dx * dx + dy * dy);
            const maxDistance = 150;

            if (distance < maxDistance) {
              const force = (1 - distance / maxDistance) * deformStrength * 10 * hoverInfluence * fadeFactor;
              const angle = Math.atan2(dy, dx);
              newX = newX - Math.cos(angle) * force;
              newY = newY - Math.sin(angle) * force;
            }
          }

          // Clamper dans le viewBox
          newX = Math.max(clampMinX, Math.min(clampMaxX, newX));
          newY = Math.max(clampMinY, Math.min(clampMaxY, newY));

          return { ...point, x: newX, y: newY };
        });

        const newPath = buildSVGPath(deformedPoints);
        wavePath.setAttribute("d", newPath);
        requestAnimationFrame(animate);
      }

      svg.addEventListener("mousemove", (e) => {
        const rect = svg.getBoundingClientRect();
        rawMouseX = vbX + ((e.clientX - rect.left) / rect.width) * viewBoxWidth;
        rawMouseY = vbY + ((e.clientY - rect.top) / rect.height) * viewBoxHeight;
      });

      svg.addEventListener("mouseenter", () => { hoverTarget = 1; });
      svg.addEventListener("mouseleave", () => { hoverTarget = 0; });

      animate();
    });
  }

  function parseSVGPath(pathString: string) {
    const points: Array<{ x: number; y: number; type: string }> = [];
    const commands = pathString.match(/[MLHVCSQTAZmlhvcsqtaz][^MLHVCSQTAZmlhvcsqtaz]*/gi) || [];
    let currentX = 0, currentY = 0;

    commands.forEach((cmd) => {
      const type = cmd[0];
      const coords = (cmd.slice(1).match(/-?[0-9]*\.?[0-9]+/g) || []).map(Number).filter((n) => !isNaN(n));

      if (type === "M") {
        currentX = coords[0]; currentY = coords[1];
        points.push({ x: currentX, y: currentY, type: "M" });
      } else if (type === "L") {
        for (let i = 0; i < coords.length; i += 2) {
          currentX = coords[i]; currentY = coords[i + 1];
          points.push({ x: currentX, y: currentY, type: "L" });
        }
      } else if (type === "l") {
        for (let i = 0; i < coords.length; i += 2) {
          currentX += coords[i]; currentY += coords[i + 1];
          points.push({ x: currentX, y: currentY, type: "L" });
        }
      } else if (type === "V") {
        for (let i = 0; i < coords.length; i++) {
          currentY = coords[i];
          points.push({ x: currentX, y: currentY, type: "L" });
        }
      } else if (type === "H") {
        for (let i = 0; i < coords.length; i++) {
          currentX = coords[i];
          points.push({ x: currentX, y: currentY, type: "L" });
        }
      } else if (type === "C") {
        for (let i = 0; i < coords.length; i += 6) {
          points.push({ x: coords[i], y: coords[i + 1], type: "C1" });
          points.push({ x: coords[i + 2], y: coords[i + 3], type: "C2" });
          currentX = coords[i + 4]; currentY = coords[i + 5];
          points.push({ x: currentX, y: currentY, type: "C" });
        }
      } else if (type === "c") {
        for (let i = 0; i < coords.length; i += 6) {
          points.push({ x: currentX + coords[i], y: currentY + coords[i + 1], type: "C1" });
          points.push({ x: currentX + coords[i + 2], y: currentY + coords[i + 3], type: "C2" });
          currentX += coords[i + 4]; currentY += coords[i + 5];
          points.push({ x: currentX, y: currentY, type: "C" });
        }
      } else if (type === "S" || type === "s") {
        for (let i = 0; i < coords.length; i += 4) {
          // Calculer C1 comme reflet du dernier C2 par rapport au point courant
          let c1x = currentX;
          let c1y = currentY;
          const prev = points.length > 0 ? points[points.length - 1] : null;
          const prevC2 = points.length > 1 ? points[points.length - 2] : null;
          if (prev && prevC2 && (prevC2.type === "C2" || prevC2.type === "C1")) {
            c1x = 2 * currentX - prevC2.x;
            c1y = 2 * currentY - prevC2.y;
          }
          if (type === "S") {
            points.push({ x: c1x, y: c1y, type: "C1" });
            points.push({ x: coords[i], y: coords[i + 1], type: "C2" });
            currentX = coords[i + 2]; currentY = coords[i + 3];
          } else {
            points.push({ x: c1x, y: c1y, type: "C1" });
            points.push({ x: currentX + coords[i], y: currentY + coords[i + 1], type: "C2" });
            currentX += coords[i + 2]; currentY += coords[i + 3];
          }
          points.push({ x: currentX, y: currentY, type: "C" });
        }
      }
    });
    return points;
  }

  function buildSVGPath(points: Array<{ x: number; y: number; type: string }>) {
    let path = "";
    let i = 0;
    while (i < points.length) {
      const point = points[i];
      if (isNaN(point.x) || isNaN(point.y)) { i++; continue; }
      if (point.type === "M") {
        path += `M${point.x},${point.y} `;
        i++;
      } else if (point.type === "C") {
        const c1 = points[i - 2];
        const c2 = points[i - 1];
        if (c1 && c2 && !isNaN(c1.x) && !isNaN(c1.y) && !isNaN(c2.x) && !isNaN(c2.y)) {
          path += `C${c1.x},${c1.y} ${c2.x},${c2.y} ${point.x},${point.y} `;
        }
        i++;
      } else if (point.type === "L") {
        path += `L${point.x},${point.y} `;
        i++;
      } else { i++; }
    }
    return path + "Z";
  }

  if (document.readyState !== "loading") {
    initFooterWave();
  }
</script>