---
interface Props {
  href: string;
  label?: string;
}

const { href, label = "Voir le site" } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="fab-link"
  aria-label={label}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    class="fab-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
    <polyline points="15 3 21 3 21 9" />
    <line x1="10" y1="14" x2="21" y2="3" />
  </svg>
  <span class="fab-label">{label}</span>
</a>

<style>
  .fab-link {
    position: fixed;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background-color: #111111;
    color: #fafafa;
    border-radius: 9999px;
    padding: 0.75rem 1.5rem 0.75rem 1.25rem;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1),
                0 4px 6px -4px rgb(0 0 0 / 0.1);
    border: 1px solid rgba(250, 250, 250, 0.25);
    text-decoration: none;
    transition: all 0.3s ease;
    animation: fab-slide-in 0.5s ease-out 0.8s both;
  }

  .fab-link:hover {
    background-color: #fafafa;
    color: #111111;
    border-color: #111111;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1),
                0 8px 10px -6px rgb(0 0 0 / 0.1);
  }

  .fab-link:hover .fab-icon {
    transform: rotate(-12deg);
  }

  .fab-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .fab-label {
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 2px;
  }

  @keyframes fab-slide-in {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0) scale(1);
    }
  }

  @media (min-width: 1024px) {
    .fab-link {
      left: auto;
      transform: none;
      right: 2.5rem;
      bottom: 2.5rem;
      animation-name: fab-slide-in-desktop;
    }
    .fab-icon {
      width: 1.5rem;
      height: 1.5rem;
    }
    .fab-label {
      font-size: 1rem;
    }
  }

  @media (min-width: 1536px) {
    .fab-link {
      bottom: 3rem;
      right: 3rem;
    }
  }

  @keyframes fab-slide-in-desktop {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
