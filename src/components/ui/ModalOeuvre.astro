---
import { getImageUrl } from '../../lib/backend';

interface Props {
	modalId: string;
	artiste: any;
	photos: string[];
	oeuvreTitre?: string;
}

const { modalId, artiste, photos = [], oeuvreTitre } = Astro.props;

const oeuvres = (artiste?.expand?.oeuvres_id || []) as any[];
const avatarUrl = artiste?.avatar ? getImageUrl(artiste, artiste.avatar) : null;
---

<div id={modalId} class="artwork-modal fixed inset-0 z-500 hidden">
	<!-- Overlay semi-transparent : fond panorama visible -->
	<div class="modal-overlay absolute inset-0 bg-black/55 backdrop-blur-sm cursor-pointer"></div>

	<!-- Bouton fermer : top-left de l'écran, hors du modal -->
	<button
		class="modal-close absolute z-20 flex items-center justify-center bg-black text-white hover:bg-black/70 transition-colors cursor-pointer"
		style="top: 5rem; left: 5rem; width: 4rem; height: 4rem; border-radius: 9999px; flex-shrink: 0;"
		aria-label="Fermer"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
		</svg>
	</button>

	<!-- Lightbox plein écran pour chaque photo (clic image) -->
	{photos.map((photo, index) => (
		<div
			id={`lb-${modalId}-${index}`}
			class="fixed inset-0 items-center justify-center cursor-pointer"
			style="display:none; z-index:9999; background:rgba(0,0,0,0.95);"
			onclick="this.style.display='none'"
		>
			<img src={photo} alt={`${oeuvreTitre ?? 'Oeuvre'} — plein écran`} class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg" style="pointer-events:none;" />
		</div>
	))}

	<!-- Boîte modale -->
	<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10 w-[97%] lg:w-[94%] max-w-120 lg:max-w-225 xl:max-w-300">

		<!-- Contenu visuel du modal -->
		<div
			class="bg-primary/90 border border-secondary/20 rounded-xl p-4 lg:p-6 xl:p-8 overflow-x-hidden overflow-y-auto xl:overflow-hidden"
			style="max-height: min(90vh, 700px);"
		>

		<!-- Layout 2 colonnes, toujours en ligne -->
		<div class="flex flex-col lg:flex-row gap-4 xl:gap-6">

			<!-- Colonne gauche : se dimensionne sur l'image -->
			<div class="shrink-0 flex flex-col gap-2 max-w-full lg:max-w-120 xl:max-w-160">
				{photos.length > 0 ? (
					<div class="modal-gallery flex flex-col gap-2" data-total={photos.length}>
						{photos.map((photo, index) => (
							<div class:list={['modal-slide', { hidden: index !== 0 }]}>
								<img
									src={photo}
									alt={`${oeuvreTitre ?? 'Oeuvre'} — photo ${index + 1}`}
								class="block object-contain cursor-zoom-in rounded-lg modal-main-img"
								loading="lazy"
								onclick={`document.getElementById('lb-${modalId}-${index}').style.display='flex'`}
								/>
							</div>
						))}
						{photos.length > 1 && (
							<div class="flex items-center justify-between mt-2 shrink-0">
							<button class="carousel-prev cursor-pointer w-8 h-8 rounded-full bg-secondary/15 border border-secondary/30 text-secondary flex items-center justify-center hover:bg-secondary hover:text-primary transition-colors shrink-0" aria-label="Photo précédente">←</button>
							<span class="carousel-counter text-secondary/60 text-xs font-ibm-plex-mono">1 / {photos.length}</span>
							<button class="carousel-next cursor-pointer w-8 h-8 rounded-full bg-secondary/15 border border-secondary/30 text-secondary flex items-center justify-center hover:bg-secondary hover:text-primary transition-colors shrink-0" aria-label="Photo suivante">→</button>
							</div>
						)}
					</div>
				) : (
					<div class="modal-img-placeholder flex flex-col items-center justify-center rounded-lg border border-secondary/10 bg-secondary/5">
						<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-secondary/20 mb-3">
							<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
						</svg>
						<p class="text-secondary/30 text-xs font-ibm-plex-mono uppercase tracking-widest">Photo à venir</p>
					</div>
				)}
			</div>

			<!-- Colonne droite : prend l'espace restant -->
			<div class="flex-1 min-w-0 flex flex-col">

				<!-- Card artiste : première moitié -->
				<div class="flex-1 flex flex-col justify-center">
					<p class="text-secondary/50 text-sm uppercase tracking-widest mb-3 font-ibm-plex-mono">Artiste</p>
					<a
						href={`/artistes/${artiste?.slug}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-4 hover:opacity-75 transition-opacity flex-col"
					>
						<div class="modal-artist-avatar rounded-full overflow-hidden shrink-0 border border-secondary/20">
							{avatarUrl ? (
								<img src={avatarUrl} alt={artiste?.name ?? ''} class="w-full h-full object-cover" loading="lazy" />
							) : (
								<div class="w-full h-full bg-secondary/10"></div>
							)}
						</div>
						<div>
							<p class="text-secondary font-uni-sans uppercase text-base lg:text-lg leading-tight">{artiste?.name}</p>
						</div>
					</a>
				</div>

				<!-- Oeuvres : deuxième moitié, thumbnails 40px fixes -->
				{oeuvres.length > 0 && (
					<div class="flex-1 flex flex-col min-h-0 overflow-hidden border-t border-secondary/10 pt-3">
						<p class="text-secondary/50 text-sm uppercase tracking-widest mb-2 font-ibm-plex-mono shrink-0">Ses oeuvres</p>
						<ul class="flex flex-wrap gap-1.5 content-start overflow-hidden">
							{oeuvres.map((oeuvre: any) => {
								const imgRecord = oeuvre?.expand?.oeuvres_images?.[0];
								const imgUrl = imgRecord?.images?.[0]
									? getImageUrl(imgRecord, imgRecord.images[0])
									: null;
								return (
									<li class="shrink-0">
										<a
											href={`/oeuvres/${oeuvre.slug}`}
											target="_blank"
											rel="noopener noreferrer"
											class="block hover:opacity-70 transition-opacity"
											title={oeuvre.title}
										>
											<div class="modal-thumb rounded overflow-hidden bg-secondary/10">
												{imgUrl ? (
													<img src={imgUrl} alt={oeuvre.title ?? ''} class="w-full h-full object-cover" loading="lazy" />
												) : (
													<div class="w-full h-full bg-secondary/10"></div>
												)}
											</div>
										</a>
									</li>
								);
							})}
						</ul>
					</div>
				)}

			</div>
		</div>
		</div>
	</div>
</div>

<style>
	/* === Image principale === */
	.modal-main-img {
		max-height: 200px;
		width: auto;
		max-width: 100%;
	}
	@media (min-width: 1024px) {
		.modal-main-img {
			max-height: 400px;
			max-width: 480px;
		}
	}
	@media (min-width: 1280px) {
		.modal-main-img {
			max-height: 520px;
			max-width: 640px;
		}
	}

	/* === Placeholder "photo à venir" === */
	.modal-img-placeholder {
		width: 100%;
		height: 160px;
	}
	@media (min-width: 1024px) {
		.modal-img-placeholder {
			width: 280px;
			height: 400px;
		}
	}
	@media (min-width: 1280px) {
		.modal-img-placeholder {
			width: 340px;
			height: 520px;
		}
	}

	/* === Avatar artiste === */
	.modal-artist-avatar {
		width: 80px;
		height: 80px;
		min-width: 80px;
		border-radius: 9999px;
	}
	@media (min-width: 1024px) {
		.modal-artist-avatar {
			width: 110px;
			height: 110px;
			min-width: 110px;
		}
	}
	@media (min-width: 1280px) {
		.modal-artist-avatar {
			width: 150px;
			height: 150px;
			min-width: 130px;
		}
	}

	/* === Thumbnails oeuvres === */
	.modal-thumb {
		width: 44px;
		height: 44px;
		min-width: 44px;
		flex-shrink: 0;
	}
	@media (min-width: 1280px) {
		.modal-thumb {
			width: 56px;
			height: 56px;
			min-width: 56px;
		}
	}
</style>
