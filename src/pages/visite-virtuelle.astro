---
import Layout from '../layouts/Layout.astro';
import ModalOeuvre from '../components/ui/ModalOeuvre.astro';
import { GetArtistBySlug } from '../lib/backend';

const artisteSmoky    = await GetArtistBySlug('smoky');
const artisteMelissa  = await GetArtistBySlug('jellyperle');
// Scène 1
const artisteDany     = await GetArtistBySlug('dany-galmiche');
// Scène 2
const artisteManolia  = await GetArtistBySlug('manolia-kocaoglu');
// Scène 3
const artistePhasme   = await GetArtistBySlug('phasme');
const artisteLola     = await GetArtistBySlug('lola-brouart');
// Scène 4
const artisteMaelie   = await GetArtistBySlug('maelie-addario');
const artisteNoemie   = await GetArtistBySlug('noemie-caritey');
// Scène 5
const artisteSidus    = await GetArtistBySlug('sidus');
const artistePaolo    = await GetArtistBySlug('paolo-vincent');
const artisteArthur   = await GetArtistBySlug('arthur-wicky');
const artisteAlice    = await GetArtistBySlug('alice-frelin');
// Scène 6
const artisteMathis   = await GetArtistBySlug('mathis-liegeon');
const artisteHugo     = await GetArtistBySlug('hugo-molard');
const artisteLeo      = await GetArtistBySlug('leo-baudry');
const artisteMootys   = await GetArtistBySlug('mootys');
const artisteMarion   = await GetArtistBySlug('marion-mura');
---

<Layout 
	title="Visite Virtuelle 360° | MMI Art 26"
	description="Explorez l'exposition MMI Art 26 en immersion totale grâce à notre visite virtuelle 360°. Naviguez dans les différents espaces et découvrez les oeuvres des étudiants."
>
	<!-- Écran d'introduction (TEMPORAIREMENT MASQUÉ POUR DEV) -->
	<div id="intro-screen" class="fixed inset-0 z-100 flex flex-col items-center justify-center bg-primary overflow-hidden hidden">
		<!-- Image de fond avec overlay -->
		<div class="absolute inset-0">
			<img 
				src="/360/img-0-360.jpg" 
				alt="" 
				class="w-full h-full object-cover opacity-30 blur-sm"
				loading="eager"
			/>
			<div class="absolute inset-0 bg-primary/60"></div>
		</div>
		
		<!-- Contenu centré -->
		<div class="relative z-10 flex flex-col items-center text-center px-8 max-w-2xl">
			<h1 class="text-secondary text-4xl md:text-5xl lg:text-6xl font-uni-sans uppercase tracking-wide">
				Visite Virtuelle
			</h1>
			<p class="text-secondary/80 mt-6 md:mt-8 text-sm md:text-base lg:text-lg leading-relaxed">
				Explorez l'exposition MMI Art 26 comme si vous y étiez. 
				Naviguez dans l'espace en cliquant et glissant, et déplacez-vous 
				entre les différents points de vue pour découvrir les oeuvres.
			</p>
			<div class="mt-8 md:mt-12 flex flex-col sm:flex-row gap-4">
				<button id="enter-btn" class="btn-white">
					Entrer dans l'exposition
				</button>
				<a href="/" class="btn-white border border-secondary/30 hover:border-transparent">
					Retour à l'accueil
				</a>
			</div>
			<p class="text-secondary/50 mt-8 text-xs">
				Utilisez votre souris ou votre doigt pour regarder autour de vous
			</p>
		</div>
	</div>

	<!-- Écran de chargement (TEMPORAIREMENT MASQUÉ POUR DEV) -->
	<div id="loading-screen" class="fixed inset-0 z-110 flex flex-col items-center justify-center bg-primary opacity-0 pointer-events-none transition-opacity duration-300 hidden">
		<div class="flex flex-col items-center gap-6">
			<p id="loading-text" class="text-secondary text-sm uppercase tracking-widest font-ibm-plex-mono">Chargement de l'exposition</p>
			<div class="w-48 h-1 bg-secondary/20 rounded-full overflow-hidden">
				<div id="loading-bar" class="h-full bg-secondary rounded-full transition-all duration-300" style="width: 0%"></div>
			</div>
		</div>
	</div>

	<!-- Conteneur Pannellum (AFFICHE DIRECTEMENT POUR DEV) -->
	<div id="panorama-wrapper" class="fixed inset-0 z-99 opacity-100 pointer-events-auto transition-opacity duration-500">
		<div id="panorama" class="w-full h-full">
			<!-- Bouton fullscreen personnalisé (dans le panorama pour rester visible en fullscreen) -->
			<button id="fullscreen-btn" class="absolute z-9999 bg-secondary text-primary p-1.5 rounded-md hover:opacity-70 transition-opacity cursor-pointer" style="bottom: 44px; left: 4px;" title="Plein écran">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m15 15 6 6"/><path d="m15 9 6-6"/><path d="M21 16v5h-5"/><path d="M21 8V3h-5"/><path d="M3 16v5h5"/><path d="m3 21 6-6"/><path d="M3 8V3h5"/><path d="M9 9 3 3"/>
				</svg>
			</button>
		</div>
		
		<!-- Bouton quitter (MODE DEV : redirige vers l'accueil) -->
		<a href="/" id="exit-btn" class="fixed top-6 left-6 z-50 btn-white text-sm px-4 py-2">
			Retour à l'accueil
		</a>
		
		<!-- Indicateur de position -->
		<div id="position-indicator" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-primary/80 text-secondary px-4 py-2 rounded-full text-xs uppercase tracking-wider">
			<span id="current-scene-name">Entrée de l'exposition</span>
		</div>
	</div>

	{artisteSmoky && (
		<ModalOeuvre
			modalId="modal-smoky"
			artiste={artisteSmoky}
			photos={['/photos-oeuvres/smoky1.webp']}
			oeuvreTitre="Smoky"
		/>
	)}
	{artisteMelissa && (
		<ModalOeuvre
			modalId="modal-jellyperle"
			artiste={artisteMelissa}
			photos={['/photos-oeuvres/melissa-toumazet1.webp']}
			oeuvreTitre="Melissa Toumazet"
		/>
	)}
	{/* Scène 1 */}
	{artisteDany && (
		<ModalOeuvre
			modalId="modal-dany-galmiche"
			artiste={artisteDany}
			photos={['/photos-oeuvres/dany-galmiche1.webp']}
			oeuvreTitre="Dany Galmiche"
		/>
	)}
	{/* Scène 2 */}
	{artisteManolia && (
		<ModalOeuvre
			modalId="modal-manolia-kocaoglu"
			artiste={artisteManolia}
			photos={['/photos-oeuvres/manolia-kocaoglu1.webp']}
			oeuvreTitre="Manolia Kocaoglu"
		/>
	)}
	{/* Scène 3 */}
	{artistePhasme && (
		<ModalOeuvre
			modalId="modal-phasme"
			artiste={artistePhasme}
			photos={['/photos-oeuvres/phasme1.webp']}
			oeuvreTitre="Phasme"
		/>
	)}
	{artisteLola && (
		<ModalOeuvre
			modalId="modal-lola-brouart"
			artiste={artisteLola}
			photos={['/photos-oeuvres/lola-brouart1.webp']}
			oeuvreTitre="Lola Brouart"
		/>
	)}
	{/* Scène 4 */}
	{artisteMaelie && (
		<ModalOeuvre
			modalId="modal-maelie-addario"
			artiste={artisteMaelie}
			photos={['/photos-oeuvres/maelie-addario-1.webp', '/photos-oeuvres/maelie-addario-2.webp', '/photos-oeuvres/maelie-addario-3.webp']}
			oeuvreTitre="Maelie Addario"
		/>
	)}
	{artisteNoemie && (
		<ModalOeuvre
			modalId="modal-noemie-caritey"
			artiste={artisteNoemie}
			photos={['/photos-oeuvres/noemie-caritey-1.webp', '/photos-oeuvres/noemie-caritey-2.webp', '/photos-oeuvres/noemie-caritey-3.webp']}
			oeuvreTitre="Noémie Caritey"
		/>
	)}
	{/* Scène 5 */}
	{artisteSidus && (
		<ModalOeuvre
			modalId="modal-sidus"
			artiste={artisteSidus}
			photos={[]}
			oeuvreTitre="Sidus"
		/>
	)}
	{artistePaolo && (
		<ModalOeuvre
			modalId="modal-paolo-vincent"
			artiste={artistePaolo}
			photos={['/photos-oeuvres/paolo-vincent1.webp']}
			oeuvreTitre="Paolo Vincent"
		/>
	)}
	{artisteArthur && (
		<ModalOeuvre
			modalId="modal-arthur-wicky"
			artiste={artisteArthur}
			photos={['/photos-oeuvres/arthur-wicky1.webp']}
			oeuvreTitre="Arthur Wicky"
		/>
	)}
	{artisteAlice && (
		<ModalOeuvre
			modalId="modal-alice-frelin"
			artiste={artisteAlice}
			photos={['/photos-oeuvres/alice-frelin1.webp']}
			oeuvreTitre="Alice Frelin"
		/>
	)}
	{/* Scène 6 */}
	{artisteMathis && (
		<ModalOeuvre
			modalId="modal-mathis-liegeon"
			artiste={artisteMathis}
			photos={[]}
			oeuvreTitre="Mathis Liegeon"
		/>
	)}
	{artisteHugo && (
		<ModalOeuvre
			modalId="modal-hugo-molard"
			artiste={artisteHugo}
			photos={['/photos-oeuvres/hugo-molard1.webp']}
			oeuvreTitre="Hugo Molard"
		/>
	)}
	{artisteLeo && (
		<ModalOeuvre
			modalId="modal-leo-baudry"
			artiste={artisteLeo}
			photos={['/photos-oeuvres/leo-baudry1.webp']}
			oeuvreTitre="Léo Baudry"
		/>
	)}
	{artisteMootys && (
		<ModalOeuvre
			modalId="modal-mootys"
			artiste={artisteMootys}
			photos={['/photos-oeuvres/mootys1.webp']}
			oeuvreTitre="Mootys"
		/>
	)}
	{artisteMarion && (
		<ModalOeuvre
			modalId="modal-marion-mura"
			artiste={artisteMarion}
			photos={[]}
			oeuvreTitre="Marion Mura"
		/>
	)}
</Layout>

<!-- Chargement de Pannellum depuis public -->
<link rel="stylesheet" href="/pannellum.css" />
<script is:inline src="/pannellum.js"></script>

<!-- Masquer immédiatement les éléments indésirables -->
<script is:inline>
	// Masquer immédiatement la liquid wave et autres éléments
	(function() {
		var style = document.createElement('style');
		style.textContent = 'header, footer, .background-grid, .menu-liquid-wave { display: none !important; }';
		document.head.appendChild(style);
	})();
</script>

<!-- Styles Pannellum - CSS obligatoire pour les éléments Pannellum -->
<style is:global>
	/* Masquer header/footer/wave sur toute la page visite-virtuelle */
	body:has(#intro-screen) header,
	body:has(#intro-screen) footer,
	body:has(#intro-screen) .background-grid,
	body:has(#intro-screen) .menu-liquid-wave,
	body:has(#panorama-wrapper) header,
	body:has(#panorama-wrapper) footer,
	body:has(#panorama-wrapper) .background-grid,
	body:has(#panorama-wrapper) .menu-liquid-wave {
		display: none !important;
	}
	
	/* Masquer header/footer en mode immersif (fallback) */
	body.immersive-mode header,
	body.immersive-mode footer,
	body.immersive-mode .background-grid,
	body.immersive-mode .menu-liquid-wave {
		display: none !important;
	}
	
	body.immersive-mode {
		overflow: hidden;
	}
	
	/* Fond noir pour le conteneur Pannellum pendant le chargement */
	#panorama {
		background-color: var(--color-primary) !important;
	}
	
	.pnlm-container {
		background-color: var(--color-primary) !important;
		background-image: none !important;
	}

	/* Bloquer le scroll sur la page visite-virtuelle */
	body:has(#intro-screen) {
		overflow: hidden;
	}
	
	/* Personnalisation des contrôles Pannellum */
	.pnlm-controls-container {
		bottom: 76px !important;
		top: auto !important;
		left: 4px !important;
	}
	
	.pnlm-controls {
		background: transparent !important;
		border: none !important;
		border-radius: 8px !important;
		overflow: visible !important;
	}
	
	.pnlm-zoom-in,
	.pnlm-zoom-out {
		background-color: var(--color-secondary) !important;
		border: none !important;
		border-radius: 6px !important;
		margin: 2px !important;
		width: 26px !important;
		height: 26px !important;
		filter: invert(1) !important;
	}
	
	.pnlm-zoom-in:hover,
	.pnlm-zoom-out:hover {
		opacity: 0.7;
	}
	
	/* Bouton fullscreen visible même en mode plein écran */
	#panorama:fullscreen #fullscreen-btn,
	#panorama:-webkit-full-screen #fullscreen-btn {
		display: block !important;
	}
	
	/* Hotspots personnalisés */
	.pnlm-hotspot {
		width: auto !important;
		height: auto !important;
	}
	
	.pnlm-hotspot-base {
		background: none !important;
		border: none !important;
	}
	
	.custom-hotspot {
		background: var(--color-primary);
		color: var(--color-secondary);
		font-family: var(--font-ibm-plex-mono);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 1px;
		padding: 10px 16px;
		border-radius: 9999px;
		border: 1px solid var(--color-secondary);
		cursor: pointer;
		transition: all 0.3s ease;
		white-space: nowrap;
	}
	
	.custom-hotspot:hover {
		background: var(--color-secondary);
		color: var(--color-primary);
	}
	
	/* Tooltip Pannellum */
	.pnlm-tooltip {
		background: var(--color-primary) !important;
		color: var(--color-secondary) !important;
		font-family: var(--font-ibm-plex-mono) !important;
		border-radius: 8px !important;
		padding: 8px 12px !important;
		font-size: 12px !important;
	}
	
	.pnlm-tooltip::before {
		border-top-color: var(--color-primary) !important;
	}
	
	/* Masquer le logo Pannellum */
	.pnlm-about-msg,
	.pnlm-load-box {
		display: none !important;
	}
	
	/* Loader personnalisé */
	.pnlm-lbar {
		background: var(--color-secondary) !important;
	}
	
	.pnlm-lbar-fill {
		background: var(--color-primary) !important;
	}

	/* === Hotspot oeuvre pulsant === */
	.artwork-hotspot {
		position: relative;
		width: 28px;
		height: 28px;
		cursor: pointer;
	}

	.artwork-hotspot .hs-ping {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 28px;
		height: 28px;
		background: var(--color-secondary);
		border-radius: 50%;
		opacity: 0.4;
		animation: artwork-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
	}

	.artwork-hotspot .hs-dot {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 10px;
		height: 10px;
		background: var(--color-secondary);
		border-radius: 50%;
		z-index: 1;
	}

	@keyframes artwork-ping {
		0%   { transform: translate(-50%, -50%) scale(0.5); opacity: 0.4; }
		100% { transform: translate(-50%, -50%) scale(2.4); opacity: 0; }
	}

	.artwork-hotspot:hover .hs-dot {
		opacity: 0.7;
	}

	/* Animation ouverture modal */
	.artwork-modal:not(.hidden) {
		animation: modal-fadein 0.2s ease;
	}

	@keyframes modal-fadein {
		from { opacity: 0; }
		to   { opacity: 1; }
	}
</style>

<script is:inline>
	document.addEventListener('astro:page-load', () => {
		const introScreen = document.getElementById('intro-screen');
		const panoramaWrapper = document.getElementById('panorama-wrapper');
		const loadingScreen = document.getElementById('loading-screen');
		const loadingBar = document.getElementById('loading-bar');
		const loadingText = document.getElementById('loading-text');
		const enterBtn = document.getElementById('enter-btn');
		const exitBtn = document.getElementById('exit-btn');
		const currentSceneName = document.getElementById('current-scene-name');
		
		let viewer = null;
		let isLoading = false;
		
		// Configuration des scènes
		const sceneNames = {
			'scene0': "Entrée de l'exposition",
			'scene1': 'Dany Galmiche',
			'scene2': 'Point de vue 2',
			'scene3': 'Point de vue 3',
			'scene4': 'Point de vue 4',
			'scene5': 'Point de vue 5',
			'scene6': 'Point de vue 6'
		};
		
		// Fonction pour créer un hotspot personnalisé
		function createHotspotElement(text) {
			const div = document.createElement('div');
			div.classList.add('custom-hotspot');
			div.innerText = text;
			return div;
		}

		// Fonction pour créer un hotspot oeuvre pulsant
		function createArtworkHotspot() {
			const wrapper = document.createElement('div');
			wrapper.classList.add('artwork-hotspot');
			const ping = document.createElement('span');
			ping.classList.add('hs-ping');
			const dot = document.createElement('span');
			dot.classList.add('hs-dot');
			wrapper.appendChild(ping);
			wrapper.appendChild(dot);
			return wrapper;
		}

		// Ouvrir un modal oeuvre
		function openArtworkModal(modalId) {
			const modal = document.getElementById(modalId);
			if (!modal) return;
			modal.classList.remove('hidden');
		}

		// Fermer tous les modals oeuvres
		function closeAllArtworkModals() {
			document.querySelectorAll('.artwork-modal').forEach(function(m) {
				m.classList.add('hidden');
			});
		}

		// Initialiser les carrousels des modals
		function initCarousels() {
			document.querySelectorAll('.modal-gallery[data-total]').forEach(function(gallery) {
				const total = parseInt(gallery.dataset.total);
				if (total <= 1) return;
				const slides = gallery.querySelectorAll('.modal-slide');
				const counter = gallery.querySelector('.carousel-counter');
				const prev = gallery.querySelector('.carousel-prev');
				const next = gallery.querySelector('.carousel-next');
				let current = 0;
				function show(i) {
					slides.forEach(function(s, idx) { s.classList.toggle('hidden', idx !== i); });
					if (counter) counter.textContent = (i + 1) + ' / ' + total;
					current = i;
				}
				if (prev) prev.addEventListener('click', function() { show((current - 1 + total) % total); });
				if (next) next.addEventListener('click', function() { show((current + 1) % total); });
			});
		}

		// Initialisation de Pannellum
		function initPannellum() {
			if (typeof pannellum === 'undefined') {
				console.error('Pannellum not loaded');
				return;
			}
			
			viewer = pannellum.viewer('panorama', {
				default: {
					firstScene: 'scene0',
					author: 'MMI Art 26',
					sceneFadeDuration: 1000,
					autoLoad: true,
					autoRotate: -1,
					autoRotateInactivityDelay: 3000,
					compass: false,
					showControls: true,
					showFullscreenCtrl: false,
					mouseZoom: true,
					keyboardZoom: true,
					draggable: true,
					friction: 0.15,
					hfov: 120,
					minHfov: 50,
					maxHfov: 120,
					hotSpotDebug: true // Activer pour debug, désactiver en prod
				},
				scenes: {
					scene0: {
						type: 'equirectangular',
						panorama: '/360/img-0-360.jpg',
						pitch: -6,
						yaw: -64,
						hotSpots: [
							{
								pitch: -8,
								yaw: -5,
								type: 'scene',
								text: 'Aller au point de vue 1',
								sceneId: 'scene1',
								targetPitch: 4,
								targetYaw: 90,
								createTooltipFunc: function(hotSpotDiv) {
									const span = createHotspotElement('1');
									hotSpotDiv.appendChild(span);
								},
								createTooltipArgs: 'Avancer'
							},
							{
								pitch: -6,
								yaw: -103,
								type: 'scene',
								text: 'Aller au point de vue 2',
								sceneId: 'scene2',
								targetPitch: -22,
								targetYaw: 115,
								createTooltipFunc: function(hotSpotDiv) {
									const span = createHotspotElement('2');
									hotSpotDiv.appendChild(span);
								},
								createTooltipArgs: 'Point de vue 2'
							},
							{
								pitch: -5,
								yaw: -83,
								type: 'scene',
								text: 'Aller au point de vue 3',
								sceneId: 'scene3',
								targetPitch: -12,
								targetYaw: -113,
								createTooltipFunc: function(hotSpotDiv) {
									const span = createHotspotElement('3');
									hotSpotDiv.appendChild(span);
								},
								createTooltipArgs: 'Point de vue 3'
							},
							{
								pitch: -2,
								yaw: -55,
								type: 'scene',
								text: 'Aller au point de vue 4',
								sceneId: 'scene4',
								targetPitch: -19,
								targetYaw: 73,
								createTooltipFunc: function(hotSpotDiv) {
									const span = createHotspotElement('4');
									hotSpotDiv.appendChild(span);
								},
								createTooltipArgs: 'Point de vue 4'
							},
			
						]
					},
					scene1: {
						type: 'equirectangular',
						panorama: '/360/img-1-360.jpg',
						pitch: 4,
						yaw: 90,
						hotSpots: [
							{
								pitch: -6,
								yaw: 162,
								type: 'scene',
								text: 'Retour au point de vue 0',
								sceneId: 'scene0',
								targetPitch: -6,
								targetYaw: -64,
								createTooltipFunc: function(hotSpotDiv) {
									const span = createHotspotElement('0');
									hotSpotDiv.appendChild(span);
								},
								createTooltipArgs: 'Retour'
							},
							{
								pitch: -4,
								yaw: -103,
								type: 'scene',
								text: 'Aller au point de vue 2',
								sceneId: 'scene2',
								targetPitch: -22,
								targetYaw: 115,
								createTooltipFunc: function(hotSpotDiv) {
									const span = createHotspotElement('2');
									hotSpotDiv.appendChild(span);
								},
								createTooltipArgs: 'Avancer'
							},
							{
								pitch: -3,
								yaw: -72,
								type: 'scene',
								text: 'Aller au point de vue 3',
								sceneId: 'scene3',
								targetPitch: -12,
								targetYaw: -113,
								createTooltipFunc: function(hotSpotDiv) {
									const span = createHotspotElement('3');
									hotSpotDiv.appendChild(span);
